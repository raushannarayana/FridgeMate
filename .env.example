# Copy to .env (docker compose reads it automatically)
JWT_SECRET=put-a-long-random-string-here
DB_PASSWORD=change-me
# URL printed inside QR/NFC labels. Must be reachable by phones; camera/NFC need HTTPS (e.g. your ngrok URL).
# Leave EMPTY to auto-use the address you opened the app with (LAN IP / ngrok). http://localhost is never usable by a phone.
PUBLIC_URL=
DEMO_MODE=true
# Sign in with just a name (no email/password). Set to false for private deployments.
QUICK_LOGIN=true
# Optional SMTP for password reset emails (otherwise links are printed in the server console):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
